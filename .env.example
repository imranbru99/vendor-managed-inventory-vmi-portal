APP_NAME="VMI Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (default local). For MySQL/MariaDB set DB_CONNECTION=mysql and fill credentials.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vmi_portal
# DB_USERNAME=vmi
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Prefer redis in production:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- VMI Portal ---
DEMO_MODE=true
DEMO_PASSWORD=Demo@VMI2026!
VMI_DEMO_TENANT_SLUG=northstar-retail
VMI_INVENTORY_STALE_HOURS=24
VMI_REPLENISHMENT_DEMAND_LOOKBACK_DAYS=30
VMI_FEATURE_AUTO_REPLENISHMENT=false
VMI_FEATURE_AI_ASSIST=false
VMI_FEATURE_EDI=false

# AI Hub (optional — core VMI works without keys)
AI_HUB_ENABLED=false
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Attendance Hub (optional workforce devices)
ATTENDANCE_HUB_ENABLED=false

# Drutogoti performance profiler (platform diagnostics only)
DRUTOGOTI_ENABLED=true
DRUTOGOTI_SAMPLE_RATE=0.1
